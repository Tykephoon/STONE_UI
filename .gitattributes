# Normalise to LF in the repository regardless of the platform committing.
# Without this, a Windows checkout commits CRLF and every file looks modified
# to a collaborator on Linux or macOS.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.glb binary
*.sqlite binary
