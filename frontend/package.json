{
  "name": "@stone/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stone telemetry SPA \u2014 static bundle, zero credentials, hosted on GitHub Pages.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-secrets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "scan": "node scripts/check-bundle-secrets.mjs",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "maplibre-gl": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
