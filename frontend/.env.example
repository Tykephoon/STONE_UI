# ---------------------------------------------------------------------------
# Frontend configuration
#
# EVERY VALUE HERE IS PUBLIC. Vite inlines VITE_* variables into the bundle as
# literal strings, and the bundle is served from GitHub Pages to anyone who
# asks.
#
# There is nothing sensitive to configure. The app has no server, no accounts,
# and no third-party keys — maps use OpenStreetMap, which needs none. A
# credential placed here would be a published credential.
#
# This file is optional: the app builds and runs with no .env at all.
# ---------------------------------------------------------------------------

# Optional label shown in the sidebar footer, e.g. "local" or "production".
VITE_ENVIRONMENT_LABEL=local
