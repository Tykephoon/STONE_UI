# ---------------------------------------------------------------------------
# Frontend configuration
#
# EVERY VALUE HERE IS PUBLIC. Vite inlines VITE_* variables into the bundle as
# literal strings, and the bundle is served from GitHub Pages to anyone who
# asks. Only the API base URL and non-sensitive feature flags belong in this
# file. A credential placed here is a published credential.
#
# There is no build-time secret. If you ever find yourself adding one, the
# feature needs a backend proxy route instead.
# ---------------------------------------------------------------------------

# Where the API lives. Must exactly match an entry in the backend's
# ALLOWED_ORIGINS, scheme and port included.
VITE_API_BASE_URL=http://localhost:8080

# Optional: label shown in the sidebar footer.
VITE_ENVIRONMENT_LABEL=local
