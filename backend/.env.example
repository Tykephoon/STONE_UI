# ---------------------------------------------------------------------------
# Stone API configuration
#
# Copy to `.env` for local development. `.env` is gitignored and must never be
# committed. In production these are set as Fly.io secrets (`fly secrets set`),
# not baked into the image.
#
# NOTHING IN THIS FILE HAS A FRONTEND EQUIVALENT. The browser bundle receives
# only the public API base URL.
#
# This installation has no user accounts, so there are no session or cookie
# settings. The only credentials it holds are the upstream map keys below;
# device keys live in the database as hashes.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# SQLite file. On Fly.io this must sit on the mounted volume (/data).
DATABASE_PATH=./data/stone.sqlite

# ---------------------------------------------------------------------------
# CORS — explicit allowlist, comma separated. Never a wildcard.
# Production example:
#   ALLOWED_ORIGINS=https://tykephoon.github.io
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Proxy
#
# Rate limiting is keyed by IP. Behind a proxy that sets X-Forwarded-For
# (Fly.io does) this must be true, or every caller shares one bucket.
# ---------------------------------------------------------------------------
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Ingest
# ---------------------------------------------------------------------------
INGEST_RATE_PER_MINUTE=120
INGEST_MAX_BATCH=200

# ---------------------------------------------------------------------------
# Map proxy — THIS IS WHERE MAP CREDENTIALS LIVE.
#
# The key is substituted into the template inside the server process and is
# never sent to the browser. If both are left unset the proxy falls back to
# keyless OpenStreetMap raster tiles, which is fine for development but is not
# an appropriate production tile source under OSM's usage policy.
#
# MapTiler example:
#   MAP_TILES_URL=https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key={key}
#   MAP_TILES_KEY=your-maptiler-key
# ---------------------------------------------------------------------------
# MAP_TILES_URL=
# MAP_TILES_KEY=
MAP_TILES_ATTRIBUTION=© OpenStreetMap contributors
MAP_TILE_SIZE=256
MAP_MAX_ZOOM=19

# Geocoding proxy. Falls back to Nominatim when unset.
#   GEOCODE_URL=https://api.maptiler.com/geocoding/{q}.json?key={key}
#   GEOCODE_KEY=your-maptiler-key
# GEOCODE_URL=
# GEOCODE_KEY=

# Nominatim's usage policy requires a descriptive, contactable User-Agent.
GEO_CONTACT_USER_AGENT=stone-telemetry/1.0 (+https://github.com/Tykephoon/STONE_UI)

GEO_TILE_RATE_PER_MINUTE=600
GEO_SEARCH_RATE_PER_MINUTE=30
